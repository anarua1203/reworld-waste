# Reworld Outreach Agent — environment variables
# Copy to .env and fill in real values.  Never commit .env to version control.

# ── AgentCore Gateway (populated by phantombuster-api/get_credentials.py) ────
# Run phantombuster-api/get_credentials.py to generate phantombuster-api/credentials.env,
# then copy those four lines (GATEWAY_URL, CLIENT_ID, CLIENT_SECRET, TOKEN_URL) here.
GATEWAY_URL=
TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# SCOPE must match the RESOURCE_SERVER_ID in phantombuster-api/.env
SCOPE=phantombuster-api-gateway-id/gateway:read phantombuster-api-gateway-id/gateway:write

# ── AgentCore Runtime ARN (for Streamlit GUI — Path A direct invocation) ─────
# Retrieve with:
#   aws bedrock-agentcore-control list-agent-runtimes \
#     --query 'agentRuntimes[?agentRuntimeName==`reworld_outreach_agent`].agentRuntimeArn'
# Populated by runtime_deploy.py output or the AWS Console; never hardcode.
AGENT_RUNTIME_ARN=

# ── Build / deploy ────────────────────────────────────────────────────────────
# AgentCore Runtime today only accepts linux/arm64 images. Leave this as-is
# unless AgentCore later adds amd64 support. On Windows / Linux-x86 dev boxes,
# buildx will use QEMU to emulate arm64 — slower (~3-5 min) but works. One-time
# setup if QEMU isn't registered on your Docker Desktop:
#   docker run --privileged --rm tonistiigi/binfmt --install all
BUILD_PLATFORM=linux/arm64

# ── AWS / Bedrock ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# AWS credentials — leave blank to use the default credential chain
# (IAM role, ~/.aws/credentials, etc.) — preferred for production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── PhantomBuster Phantom (Path B / --enrich only) ────────────────────────────
# Agent ID of the LinkedIn Sales Navigator Search Export Phantom in your
# PhantomBuster workspace. Required only when invoking the agent with --enrich.
# Find via: python ../phantombuster-api/query_user.py --list-agents
PHANTOM_AGENT_ID=
