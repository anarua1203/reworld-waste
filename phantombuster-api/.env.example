# phantombuster-api — environment template
# Copy to .env and fill values before running phantombuster_api_gateway_setup.py.
# Never commit .env to version control.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# IAM user credentials (NOT SSO — AgentCore requires long-lived IAM creds).
# boto3 auto-detects these from the environment once load_dotenv() runs.
# Generate via: IAM console → Users → <user> → Security credentials → Create access key.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
# Only set if your IAM user is using temporary STS creds (uncommon for IAM users):
# AWS_SESSION_TOKEN=your_session_token_here

# ── Cognito (inbound JWT auth for the gateway) ────────────────────────────────
USER_POOL_NAME=phantombuster-api-gateway-pool
RESOURCE_SERVER_ID=phantombuster-api-gateway-id
RESOURCE_SERVER_NAME=phantombuster-api-gateway-name
CLIENT_NAME=phantombuster-api-gateway-client

# ── AgentCore Gateway ─────────────────────────────────────────────────────────
GATEWAY_NAME=phantombuster-api-gateway
TARGET_NAME=phantombuster-poc-target
IAM_ROLE_NAME=phantombuster-api-gateway
OPENAPI_SPEC_FILE=phantombuster-v2.json

# ── Credential provider (outbound to PhantomBuster API) ──────────────────────
# PhantomBuster authenticates via the X-Phantombuster-Key request header.
# CREDENTIAL_LOCATION=HEADER tells AgentCore to inject the key as a header
# rather than a query parameter.
CREDENTIAL_PROVIDER_NAME=phantombuster-api-api-key
CREDENTIAL_PARAMETER_NAME=X-Phantombuster-Key
CREDENTIAL_LOCATION=HEADER

# ── PhantomBuster API key ─────────────────────────────────────────────────────
# API_KEY_ENV_VAR: the env var name the setup script reads for the upstream secret.
# ENV_FILE_PATH:   file where the secret is stored (chmod 600, never committed).
#                  Defaults to .env next to gateway_setup; override to a path
#                  outside the repo if you want the key isolated from other config.
# Obtain your PhantomBuster API key from:
#   https://phantombuster.com/<workspace-id>/workspace-settings#api-keys
API_KEY_ENV_VAR=PHANTOMBUSTER_API_KEY
ENV_FILE_PATH=.env
PHANTOMBUSTER_API_KEY=your_phantombuster_api_key_here
